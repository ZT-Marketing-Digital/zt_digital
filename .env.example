# URL pública do site (canonical, Open Graph, JSON-LD, sitemap)
VITE_SITE_URL=https://ztdigital.com.br

# Meta Pixel (carregado só após consentimento)
VITE_META_PIXEL_ID=1400437541519673

# GA4 opcional. O site atual usa G-8ZZQQ994FV; deixe vazio para não carregar o Google Analytics.
VITE_GA4_ID=

# Endpoint do formulário. Com o PHP deste repositório publicado no cPanel: /api/lead.php
# Vazio = modo simulação (nenhum dado sai do navegador).
VITE_FORM_ENDPOINT=/api/lead.php
