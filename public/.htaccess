# Landing estática (Vite) no cPanel.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Arquivos com hash no nome podem ficar em cache por 1 ano.
  <FilesMatch "\.(js|css|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Garante a barra final na página da política (mesmo caminho do WordPress antigo).
RewriteEngine On
RewriteRule ^politica-de-privacidade-e-de-pagamento$ /politica-de-privacidade-e-de-pagamento/ [R=301,L]
